<!DOCTYPE html>
<html lang="es">
<head>
<base target="_top">
<meta charset="utf-8">
<title>Correos Masivos · Capital Humano</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
  :root{
    --navy:#0B2545; --navy-2:#13315C; --navy-3:#1D4E89;
    --gold:#C9A227; --gold-2:#E4C766; --gold-soft:#FBF5E3;
    --bg:#F4F6FA; --card:#FFFFFF; --ink:#1A2233; --muted:#667085; --line:#E3E7EF;
    --ok:#1E8E5A; --ok-soft:#E6F4EC; --err:#C0392B; --err-soft:#FBEAEA; --warn:#B7791F; --warn-soft:#FDF4E3;
    --radius:14px;
  }
  *{box-sizing:border-box}
  body{margin:0;font-family:Inter,system-ui,sans-serif;background:var(--bg);color:var(--ink);font-size:14px}
  header{background:linear-gradient(135deg,var(--navy),var(--navy-2));color:#fff;padding:18px 28px;display:flex;align-items:center;justify-content:space-between;gap:16px;border-bottom:4px solid var(--gold);flex-wrap:wrap}
  header h1{font-family:"Playfair Display",serif;font-size:24px;margin:0;letter-spacing:.3px}
  header h1 span{color:var(--gold-2)}
  header .sub{font-size:12px;opacity:.8;margin-top:2px}
  .stats{display:flex;gap:10px;flex-wrap:wrap}
  .stat{background:rgba(255,255,255,.08);border:1px solid rgba(201,162,39,.45);border-radius:10px;padding:7px 12px;font-size:12px}
  .stat b{color:var(--gold-2);font-size:15px;margin-left:4px}
  .stat a{color:var(--gold-2)}
  main{max-width:1280px;margin:0 auto;padding:22px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:20px}
  @media (max-width:980px){main{grid-template-columns:1fr}}
  .card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);box-shadow:0 1px 3px rgba(11,37,69,.06);overflow:hidden}
  .card-h{display:flex;align-items:center;gap:10px;padding:14px 18px;border-bottom:1px solid var(--line);background:#FAFBFD}
  .num{width:26px;height:26px;border-radius:50%;background:var(--navy);color:var(--gold-2);display:grid;place-items:center;font-weight:700;font-size:13px;flex:none}
  .card-h h2{font-size:15px;margin:0;font-weight:600;flex:1}
  .card-b{padding:16px 18px}
  .full{grid-column:1/-1}
  .send-grid{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:20px}
  @media (max-width:980px){.send-grid{grid-template-columns:1fr}}
  label{font-size:12px;font-weight:600;color:var(--navy-2);display:block;margin:10px 0 5px}
  input[type=text],input[type=email],select,textarea{width:100%;padding:9px 11px;border:1px solid var(--line);border-radius:9px;font:inherit;background:#fff;color:var(--ink)}
  input:focus,select:focus,textarea:focus{outline:2px solid var(--gold-2);border-color:var(--gold)}
  textarea{resize:vertical}
  .row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  @media (max-width:600px){.row{grid-template-columns:1fr}}
  .tabs{display:flex;gap:6px;margin-bottom:12px;flex-wrap:wrap}
  .tab{border:1px solid var(--line);background:#fff;border-radius:999px;padding:6px 14px;cursor:pointer;font:inherit;font-size:13px;color:var(--muted)}
  .tab.on{background:var(--navy);color:#fff;border-color:var(--navy)}
  .pane{display:none}.pane.on{display:block}
  .btn{border:none;border-radius:9px;padding:9px 16px;font:inherit;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:7px}
  .btn:disabled{opacity:.5;cursor:not-allowed}
  .btn-p{background:var(--navy);color:#fff}.btn-p:hover:not(:disabled){background:var(--navy-3)}
  .btn-g{background:var(--gold);color:var(--navy)}.btn-g:hover:not(:disabled){background:var(--gold-2)}
  .btn-o{background:#fff;color:var(--navy);border:1px solid var(--line)}.btn-o:hover:not(:disabled){border-color:var(--gold)}
  .btn-d{background:var(--err-soft);color:var(--err)}
  .actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
  .drop{border:2px dashed var(--line);border-radius:12px;padding:22px;text-align:center;color:var(--muted);cursor:pointer;transition:.15s}
  .drop:hover,.drop.over{border-color:var(--gold);background:var(--gold-soft)}
  .hint{font-size:12px;color:var(--muted);margin-top:6px;line-height:1.45}
  .badges{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}
  .badge{border-radius:999px;padding:4px 11px;font-size:12px;font-weight:600}
  .b-ok{background:var(--ok-soft);color:var(--ok)}.b-err{background:var(--err-soft);color:var(--err)}.b-warn{background:var(--warn-soft);color:var(--warn)}.b-n{background:#EEF2F8;color:var(--navy-2)}
  .tbl-wrap{max-height:260px;overflow:auto;border:1px solid var(--line);border-radius:10px}
  table{border-collapse:collapse;width:100%;font-size:12px}
  th,td{padding:7px 9px;border-bottom:1px solid var(--line);text-align:left;white-space:nowrap}
  th{background:var(--navy);color:#fff;position:sticky;top:0;font-weight:600}
  tr.bad td{background:var(--err-soft)} tr.dup td{background:var(--warn-soft)}
  td.x{cursor:pointer;color:var(--muted);text-align:center}td.x:hover{color:var(--err)}
  .chips{display:flex;gap:6px;flex-wrap:wrap}
  .chip{background:var(--gold-soft);border:1px solid var(--gold-2);color:var(--navy);border-radius:7px;padding:3px 9px;font-size:12px;cursor:pointer;font-family:ui-monospace,monospace}
  .chip:hover{background:var(--gold-2)}
  .toolbar{display:flex;gap:3px;flex-wrap:wrap;padding:6px;border:1px solid var(--line);border-bottom:none;border-radius:10px 10px 0 0;background:#FAFBFD;align-items:center}
  .toolbar button{border:1px solid transparent;background:none;border-radius:6px;padding:5px 8px;cursor:pointer;font:inherit;font-size:13px;color:var(--navy);min-width:30px}
  .toolbar button:hover{background:#fff;border-color:var(--line)}
  .toolbar.html-mode button:not(#btnHtml),.toolbar.html-mode input[type=color]{opacity:.35;pointer-events:none}
  .toolbar .sep{width:1px;height:20px;background:var(--line);margin:0 4px}
  .toolbar input[type=color]{width:28px;height:26px;border:none;background:none;padding:0;cursor:pointer}
  .toolbar .sp{flex:1}
  #editor{min-height:260px;max-height:460px;overflow:auto;border:1px solid var(--line);border-radius:0 0 10px 10px;padding:14px;line-height:1.55;background:#fff}
  #editor:focus{outline:2px solid var(--gold-2)}
  #htmlSrc{display:none;min-height:260px;border-radius:0 0 10px 10px;font-family:ui-monospace,monospace;font-size:12px}
  .check{display:flex;align-items:center;gap:8px;margin-top:12px;font-size:13px}
  .files{display:flex;flex-direction:column;gap:6px;margin-top:8px}
  .file{display:flex;justify-content:space-between;align-items:center;background:#F7F8FB;border:1px solid var(--line);border-radius:8px;padding:6px 10px;font-size:12px}
  .file button{border:none;background:none;color:var(--err);cursor:pointer;font-size:14px}
  .prev-h{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:10px}
  .prev-h select{max-width:320px}
  .mail-meta{background:#F7F8FB;border:1px solid var(--line);border-radius:10px 10px 0 0;padding:10px 14px;font-size:12px;line-height:1.7}
  .mail-meta b{color:var(--navy-2)}
  iframe#prev{width:100%;height:480px;border:1px solid var(--line);border-top:none;border-radius:0 0 10px 10px;background:#fff}
  .progress{height:12px;background:#EEF2F8;border-radius:999px;overflow:hidden;margin:12px 0 6px}
  .progress>div{height:100%;width:0;background:linear-gradient(90deg,var(--gold),var(--gold-2));transition:width .3s}
  #log{max-height:220px;overflow:auto;font-family:ui-monospace,monospace;font-size:12px;background:#0E1B2E;color:#D6DEEB;border-radius:10px;padding:10px 12px;margin-top:10px;display:none}
  #log .ok{color:#7FD1A6}#log .er{color:#F59C95}#log .wa{color:#F3CF7A}
  .modal-bg{position:fixed;inset:0;background:rgba(11,37,69,.55);display:none;align-items:center;justify-content:center;z-index:50;padding:16px}
  .modal{background:#fff;border-radius:16px;max-width:480px;width:100%;padding:22px;border-top:5px solid var(--gold)}
  .modal h3{margin:0 0 10px;font-family:"Playfair Display",serif;color:var(--navy);font-size:20px}
  .modal ul{padding-left:18px;line-height:1.7;margin:8px 0}
  .modal .alerta{background:var(--err-soft);color:var(--err);border-radius:8px;padding:8px 10px;font-size:13px;margin:8px 0}
  .modal .aviso{background:var(--warn-soft);color:var(--warn);border-radius:8px;padding:8px 10px;font-size:13px;margin:8px 0}
  .toast{position:fixed;bottom:20px;right:20px;background:var(--navy);color:#fff;padding:12px 16px;border-radius:10px;border-left:4px solid var(--gold);box-shadow:0 8px 24px rgba(0,0,0,.2);font-size:13px;opacity:0;transform:translateY(10px);transition:.25s;z-index:60;max-width:360px}
  .toast.on{opacity:1;transform:none}
  .toast.err{border-left-color:var(--err)}
  .spin{width:14px;height:14px;border:2px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;animation:s 1s linear infinite;display:none}
  .loading .spin{display:inline-block}
  @keyframes s{to{transform:rotate(360deg)}}
</style>
</head>
<body>
<header>
  <div>
    <h1>Correos <span>Masivos</span></h1>
    <div class="sub">Grupo Saint Luke's Hospitals · Capital Humano</div>
  </div>
  <div class="stats">
    <div class="stat">Cuenta:<b id="stUser">…</b></div>
    <div class="stat">Envíos disponibles hoy:<b id="stQuota">…</b></div>
    <div class="stat"><a id="stLog" href="#" target="_blank" rel="noopener">Abrir bitácora ↗</a></div>
  </div>
</header>
<main>
  <!-- 1. DESTINATARIOS -->
  <section class="card">
    <div class="card-h"><div class="num">1</div><h2>Destinatarios</h2><span class="badge b-n" id="countBadge">0</span></div>
    <div class="card-b">
      <div class="tabs">
        <button class="tab on" data-pane="pPaste">Pegar lista</button>
        <button class="tab" data-pane="pFile">Archivo Excel / CSV</button>
        <button class="tab" data-pane="pSheet">Google Sheet</button>
      </div>
      <div class="pane on" id="pPaste">
        <textarea id="pasteArea" rows="7" placeholder="Pega aquí desde Excel o escribe uno por línea:&#10;&#10;correo,nombre,puesto&#10;ana.lopez@ejemplo.com,Ana López,Enfermera&#10;juan.perez@ejemplo.com,Juan Pérez,Camillero"></textarea>
        <div class="hint">Si la primera línea son encabezados (correo, nombre, puesto…), cada columna se vuelve una variable. Si no, se toma el correo y el nombre de cada línea.</div>
        <div class="actions"><button class="btn btn-p" id="btnPaste">Cargar lista</button></div>
      </div>
      <div class="pane" id="pFile">
        <div class="drop" id="drop">Arrastra un archivo <b>.xlsx</b>, <b>.xls</b> o <b>.csv</b> aquí<br>o haz clic para seleccionarlo</div>
        <input type="file" id="fileIn" accept=".xlsx,.xls,.csv,.txt" hidden>
        <div class="hint">Se lee la primera hoja. La primera fila debe tener los encabezados.</div>
      </div>
      <div class="pane" id="pSheet">
        <label>URL de la Google Sheet</label>
        <input type="text" id="sheetUrl" placeholder="https://docs.google.com/spreadsheets/d/…">
        <label>Pestaña</label>
        <select id="sheetTab"><option value="">(primera pestaña)</option></select>
        <div class="actions"><button class="btn btn-p" id="btnSheet"><span class="spin"></span>Leer hoja</button></div>
      </div>
      <div id="recipWrap" style="display:none">
        <div class="row" style="margin-top:12px">
          <div><label>Columna de correo</label><select id="emailCol"></select></div>
          <div><label>Buscar</label><input type="text" id="search" placeholder="Filtrar por cualquier dato…"></div>
        </div>
        <div class="badges" id="badges"></div>
        <div class="tbl-wrap"><table id="tbl"></table></div>
        <div class="hint" id="tblNote"></div>
        <div class="actions">
          <button class="btn btn-o" id="btnCleanBad">Quitar inválidos y duplicados</button>
          <button class="btn btn-d" id="btnClear">Vaciar lista</button>
        </div>
      </div>
    </div>
  </section>
  <!-- 2. MENSAJE -->
  <section class="card">
    <div class="card-h"><div class="num">2</div><h2>Mensaje</h2></div>
    <div class="card-b">
      <div class="row">
        <div><label>Nombre de la campaña (para la bitácora)</label><input type="text" id="campana" placeholder="Ej. Aviso de capacitación octubre"></div>
        <div><label>Nombre del remitente</label><input type="text" id="remitente" value="Capital Humano · Saint Luke's"></div>
      </div>
      <div class="row">
        <div><label>Responder a (opcional)</label><input type="email" id="replyTo" placeholder="rh@ejemplo.com"></div>
        <div><label>CC en cada correo (opcional)</label><input type="text" id="cc" placeholder="jefatura@ejemplo.com"></div>
      </div>
      <label>Asunto</label>
      <input type="text" id="asunto" placeholder="Ej. {{nombre}}, tu capacitación está programada">
      <label>Variables disponibles <span style="font-weight:400;color:var(--muted)">(clic para insertar en el cuerpo o en el asunto)</span></label>
      <div class="chips" id="chips"><span class="hint" style="margin:0">Carga destinatarios para ver sus columnas.</span></div>
      <label>Cuerpo del correo</label>
      <div class="toolbar" id="toolbar">
        <button data-cmd="bold" title="Negrita"><b>B</b></button>
        <button data-cmd="italic" title="Cursiva"><i>I</i></button>
        <button data-cmd="underline" title="Subrayado"><u>U</u></button>
        <span class="sep"></span>
        <button data-cmd="formatBlock" data-val="H2" title="Título">T</button>
        <button data-cmd="formatBlock" data-val="P" title="Párrafo">¶</button>
        <button data-cmd="insertUnorderedList" title="Viñetas">• ≡</button>
        <button data-cmd="insertOrderedList" title="Numeración">1.</button>
        <span class="sep"></span>
        <button data-cmd="justifyLeft" title="Izquierda">⇤</button>
        <button data-cmd="justifyCenter" title="Centrar">↔</button>
        <span class="sep"></span>
        <button id="btnLink" title="Insertar enlace">🔗</button>
        <button id="btnImg" title="Insertar imagen por URL">🖼</button>
        <input type="color" id="color" value="#0B2545" title="Color de texto">
        <button data-cmd="removeFormat" title="Quitar formato">⌫</button>
        <span class="sp"></span>
        <button id="btnHtml" title="Editar HTML">&lt;/&gt;</button>
      </div>
      <div id="editor" contenteditable="true"><p>Estimado(a) <b>{{nombre}}</b>:</p><p>Escribe aquí tu mensaje.</p><p>Saludos cordiales,<br>Capital Humano</p></div>
      <textarea id="htmlSrc"></textarea>
      <label class="check"><input type="checkbox" id="useFrame" checked> Usar diseño institucional (encabezado y pie)</label>
      <div class="row" id="frameOpts">
        <div><label>Título del encabezado</label><input type="text" id="frameTitle" value="Grupo Saint Luke's Hospitals"></div>
        <div><label>Texto del pie</label><input type="text" id="frameFoot" value="Capital Humano · Este es un correo informativo."></div>
      </div>
      <label>Adjuntos (se envían a todos · máx. 20 MB en total)</label>
      <input type="file" id="attIn" multiple>
      <div class="files" id="files"></div>
    </div>
  </section>
  <!-- 3. VISTA PREVIA Y ENVÍO -->
  <section class="card full">
    <div class="card-h"><div class="num">3</div><h2>Vista previa y envío</h2></div>
    <div class="card-b send-grid">
      <div>
        <div class="prev-h">
          <span style="font-size:12px;font-weight:600;color:var(--navy-2)">Ver como:</span>
          <select id="prevWho"><option value="-1">(sin destinatarios)</option></select>
        </div>
        <div class="mail-meta" id="meta"></div>
        <iframe id="prev" sandbox=""></iframe>
      </div>
      <div>
        <label>Correo para envío de prueba</label>
        <input type="email" id="testTo">
        <div class="actions"><button class="btn btn-o" id="btnTest"><span class="spin" style="border-color:rgba(11,37,69,.3);border-top-color:var(--navy)"></span>Enviar prueba</button></div>
        <div class="hint">La prueba usa los datos del destinatario seleccionado en “Ver como” y no copia a CC.</div>
        <hr style="border:none;border-top:1px solid var(--line);margin:18px 0">
        <div class="row">
          <div><label>Correos por lote</label><select id="batch"><option>5</option><option selected>10</option><option>20</option></select></div>
          <div><label>Pausa entre lotes</label><select id="pause"><option value="0">Sin pausa</option><option value="2" selected>2 segundos</option><option value="5">5 segundos</option></select></div>
        </div>
        <div class="actions">
          <button class="btn btn-g" id="btnSend">✉ Enviar a todos</button>
          <button class="btn btn-o" id="btnPauseRun" style="display:none">Pausar</button>
          <button class="btn btn-d" id="btnStop" style="display:none">Detener</button>
        </div>
        <div class="progress"><div id="bar"></div></div>
        <div class="hint" id="progTxt">Listo para enviar.</div>
        <div id="log"></div>
        <div class="actions"><button class="btn btn-o" id="btnCsv" style="display:none">Descargar resultados (CSV)</button></div>
      </div>
    </div>
  </section>
</main>
<div class="modal-bg" id="modalBg">
  <div class="modal">
    <h3>Confirmar envío</h3>
    <div id="modalBody"></div>
    <div class="actions" style="justify-content:flex-end">
      <button class="btn btn-o" id="mCancel">Cancelar</button>
      <button class="btn btn-g" id="mOk">Sí, enviar</button>
    </div>
  </div>
</div>
<div class="toast" id="toast"></div>
<script>
/* ============================================================
 *  Estado
 * ============================================================ */
const S = {
  headers: [],      // nombres originales de columnas
  keys: [],         // claves normalizadas
  rows: [],         // [{...}] con claves normalizadas
  emailKey: '',
  attachments: [],  // {file, nombre, tamano}
  quota: 0,
  ready: false, testing: false,
  running: false, paused: false, stop: false,
  results: []
};
const $ = id => document.getElementById(id);
const EMAIL_RE = /^[^\s@,;<>]+@[^\s@,;<>]+\.[^\s@,;<>]{2,}$/;
const MAX_FILAS_TABLA = 500;
const has = (o, k) => !!o && Object.prototype.hasOwnProperty.call(o, k);
function run(fn, ...args){
  return new Promise((res, rej) => {
    google.script.run.withSuccessHandler(res).withFailureHandler(e => rej(e && e.message ? e : new Error(String(e))))[fn](...args);
  });
}
/* Errores del servidor: VALIDACION = no se envió nada; OCUPADO = reintentar */
function msgErr(e){ return String((e && e.message) || e).replace(/^(Error: )?(VALIDACION|OCUPADO): /, ''); }
function esValidacion(e){ return /VALIDACION: /.test(String((e && e.message) || e)); }
function toast(msg, err){
  const t = $('toast'); t.textContent = msg; t.className = 'toast on' + (err ? ' err' : '');
  clearTimeout(t._t); t._t = setTimeout(() => t.className = 'toast', 4500);
}
function clave(s){
  return String(s).normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim().replace(/[^a-z0-9]+/g,'_').replace(/^_|_$/g,'');
}
function esc(s){ return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function busy(btn, on){ btn.disabled = on; btn.classList.toggle('loading', on); }
/* ============================================================
 *  Inicio
 * ============================================================ */
run('getInfo').then(i => {
  $('stUser').textContent = i.cuentaEnvio || i.usuario || '—';
  $('testTo').value = i.usuario || '';
  setQuota(i.cuota);
  $('stLog').href = i.bitacora;
  S.ready = true;
}).catch(e => {
  S.ready = false;
  $('stUser').textContent = 'Sin conexión'; $('stQuota').textContent = 'No disponible';
  $('progTxt').textContent = 'No se pudo iniciar: ' + msgErr(e);
  toast('No se pudo leer la cuenta: ' + msgErr(e), true);
});
document.querySelectorAll('.tab').forEach(t => t.onclick = () => {
  document.querySelectorAll('.tab').forEach(x => x.classList.toggle('on', x === t));
  document.querySelectorAll('.pane').forEach(p => p.classList.toggle('on', p.id === t.dataset.pane));
});
/* ============================================================
 *  Carga de destinatarios
 * ============================================================ */
function parseDelimited(text){
  text = String(text).replace(/^\ufeff/,'');
  const first = text.split(/\r?\n/)[0];
  const sep = first.includes('\t') ? '\t' : (first.includes(';') && !first.includes(',') ? ';' : ',');
  const rows = []; let row = [], cell = '', quoted = false;
  for (let i = 0; i < text.length; i++){
    const c = text[i];
    if (c === '"'){ if (quoted && text[i+1] === '"'){ cell += '"'; i++; } else quoted = !quoted; }
    else if (c === sep && !quoted){ row.push(cell.trim()); cell = ''; }
    else if ((c === '\n' || c === '\r') && !quoted){ if (c === '\r' && text[i+1] === '\n') i++; row.push(cell.trim()); rows.push(row); row = []; cell = ''; }
    else cell += c;
  }
  if (quoted) throw new Error('Hay comillas sin cerrar en la lista.');
  row.push(cell.trim()); rows.push(row); return rows;
}
function loadMatrix(m){
  m = (m || []).filter(r => Array.isArray(r) && r.some(c => String(c ?? '').trim() !== ''));
  if (!m.length){ toast('No se encontraron datos.', true); return; }
  const first = m[0].map(c => String(c ?? ''));
  const hasHeader = !first.some(c => EMAIL_RE.test(c.trim()));
  let headers;
  if (hasHeader){ headers = first.map(x => x.replace(/^\ufeff/,'')); m = m.slice(1); }
  else {
    const n = Math.max(...m.map(r => r.length));
    headers = Array.from({length:n}, (_, i) => i === 0 ? 'correo' : i === 1 ? 'nombre' : 'dato' + (i+1));
    // si el correo no está en la 1a columna, reordena por fila
    m = m.map(r => {
      const idx = r.findIndex(c => EMAIL_RE.test(String(c).trim()));
      if (idx > 0){ const e = r[idx]; r = r.slice(); r.splice(idx, 1); r.unshift(e); }
      return r;
    });
  }
  if (!m.length){ toast('Solo se encontró la fila de encabezados.', true); return; }
  // claves únicas
  const used = new Set();
  const keys = headers.map((h, i) => {
    const base = clave(h) || ('col' + (i+1)); let k = base, n = 2;
    while (used.has(k)) k = base + '_' + n++;
    used.add(k); return k;
  });
  S.headers = headers.map((h, i) => String(h).trim() || keys[i]);
  S.keys = keys;
  S.rows = m.map(r => { const o = {}; keys.forEach((k, i) => o[k] = String(r[i] ?? '').trim()); return o; });
  // detectar columna de correo: primero por nombre, luego por contenido
  let best = keys.find(k => /^(correo|email|e_mail|mail)(_|$)/.test(k)) || keys.find(k => /correo|email|mail/.test(k));
  if (!best || !S.rows.some(r => EMAIL_RE.test(r[best]))){
    let top = -1;
    keys.forEach(k => { const c = S.rows.filter(r => EMAIL_RE.test(r[k])).length; if (c > top){ top = c; best = k; } });
  }
  S.emailKey = best;
  $('search').value = '';
  renderRecipients();
  toast(S.rows.length + ' registros cargados.');
}
