  const cost = 1 + ccList().length, capacity = Math.floor(S.quota / cost), {bad, dup} = classify();
  const usadas = variablesUsadas();
  const sinColumna = usadas.filter(k => !S.keys.includes(k));
  const vacios = v.filter(r => usadas.some(k => has(r, k) && !String(r[k]).trim())).length;
  let html = `<ul><li><b>${v.length}</b> correos individuales</li><li>Asunto: <b>${esc($('asunto').value)}</b></li><li>${S.attachments.length} adjuntos</li>` +
    `<li>Se omitirán ${bad} inválidos y ${dup} duplicados</li><li>Cuota restante: ${S.quota} destinatarios</li>` +
    (cost > 1 ? `<li>Cada correo consume ${cost} de cuota (destinatario + CC); capacidad: ${capacity} correos</li>` : '') + '</ul>';
  if (sinColumna.length) html += `<div class="alerta">Las variables ${esc(sinColumna.map(k => '{{' + k + '}}').join(', '))} no existen en la lista. Corrígelas antes de enviar.</div>`;
  if (capacity < 1) html += '<div class="alerta">No queda cuota suficiente hoy. Intenta mañana.</div>';
  else if (v.length > capacity) html += `<div class="aviso">La cuota solo alcanza para ${capacity}; los restantes quedarán como pendientes.</div>`;
  if (vacios) html += `<div class="aviso">${vacios} destinatario(s) tienen vacía alguna variable usada; el texto saldrá con ese espacio en blanco.</div>`;
  html += '<p class="hint">CC es visible en cada correo. Pausar y detener actúan entre lotes; el lote en curso termina.</p>';
  $('modalBody').innerHTML = html;
  $('mOk').disabled = !!sinColumna.length || capacity < 1;
  $('modalBg').style.display = 'flex';
};
$('mCancel').onclick = () => $('modalBg').style.display = 'none';
$('mOk').onclick = () => { $('modalBg').style.display = 'none'; sendAll(); };
$('btnPauseRun').onclick = () => { S.paused = !S.paused; $('btnPauseRun').textContent = S.paused ? 'Reanudar' : 'Pausar'; $('progTxt').textContent = S.paused ? 'En pausa…' : $('progTxt').textContent; };
$('btnStop').onclick = () => { if (confirm('¿Detener después del lote actual? Los correos ya enviados no se pueden cancelar.')){ S.stop = true; S.paused = false; } };
const sleep = ms => new Promise(r => setTimeout(r, ms));
function log(msg, cls){ const l = $('log'); l.style.display = 'block'; const d = document.createElement('div'); d.className = cls || ''; d.textContent = msg; l.appendChild(d); l.scrollTop = l.scrollHeight; }
/* Reintenta el mismo lote si no hubo respuesta. Es seguro: el servidor recuerda
   qué destinatarios de esta campaña ya se enviaron y no los repite. */
async function enviarConReintentos(payload){
  const esperas = [4000, 10000, 20000];
  for (let n = 0; ; n++){
    try { return await run('enviarLote', payload); }
    catch(e){
      if (esValidacion(e) || n >= esperas.length || S.stop) throw e;
      log(`Sin confirmación (${msgErr(e)}). Reintento ${n+1} de ${esperas.length} en ${esperas[n]/1000} s…`, 'wa');
      await sleep(esperas[n]);
    }
  }
}
async function sendAll(){
  if (S.running || S.testing) return;
  const list = validRecipients().map(r => ({...r})), size = Number($('batch').value), pause = Number($('pause').value) * 1000;
  const base = Object.assign(basePayload(), {campanaId: newId()}), cost = 1 + ccList().length, emailKey = S.emailKey;
  S.resultKeys = [...S.keys]; S.resultHeaders = [...S.headers]; S.resultName = $('campana').value || $('asunto').value;
  S.running = true; S.stop = false; S.paused = false; S.results = []; lockUI(true);
  $('log').innerHTML = ''; $('bar').style.width = '0%'; $('btnCsv').style.display = 'none';
  $('btnPauseRun').style.display = ''; $('btnStop').style.display = ''; $('btnPauseRun').textContent = 'Pausar';
  window.onbeforeunload = e => { e.preventDefault(); e.returnValue = 'Hay un envío en curso.'; };
  let ids = [];
  try {
    $('progTxt').textContent = 'Preparando campaña…'; ids = await uploadAttachments(); base.adjuntos = ids;
    let i = 0;
    while (i < list.length){
      while (S.paused && !S.stop) await sleep(400);
      if (S.stop){ log('Envío detenido por el usuario.', 'wa'); break; }
      setQuota(await run('getCuota'));
      const available = Math.floor(S.quota / cost);
      if (available < 1){ log('Cuota insuficiente. Los restantes quedan pendientes.', 'er'); break; }
      const chunk = list.slice(i, i + Math.min(size, available));
      $('progTxt').textContent = `Enviando ${i+1}–${i+chunk.length} de ${list.length}…`;
      try {
        const r = await enviarConReintentos(Object.assign({}, base, {destinatarios: chunk.map(d => ({email: d[emailKey], datos: d}))}));
        setQuota(r.cuota);
        if (!r.resultados || r.resultados.length !== chunk.length) throw new Error('Respuesta incompleta del servidor.');
        r.resultados.forEach((x, j) => {
          S.results.push({email: x.email, estado: x.estado || (x.ok ? 'Enviado' : 'Error'), error: x.error || '', datos: chunk[j]});
          log(x.estado + ' · ' + x.email + (x.error ? ' · ' + x.error : ''), x.ok ? 'ok' : 'er');
        });
        (r.avisos || []).forEach(a => log(a, 'er'));
        i += chunk.length;
        if (r.resultados.some(x => ['Pendiente','Por verificar'].includes(x.estado))){ log('Se detuvo el envío: revisa los pendientes o por verificar.', 'wa'); break; }
      } catch(e){
        const seguro = esValidacion(e); // validación = no se envió nada
        chunk.forEach(d => S.results.push({email: d[emailKey], estado: seguro ? 'Error' : 'Por verificar',
          error: seguro ? msgErr(e) : 'Respuesta no confirmada: ' + msgErr(e) + '. Revisa bitácora y Enviados antes de reenviar.', datos: d}));
        log(seguro ? 'Lote rechazado: ' + msgErr(e) : 'Lote sin confirmación. Se detuvo para evitar reenvíos.', 'er');
        break;
      }
      $('bar').style.width = (S.results.length / list.length * 100) + '%';
      $('progTxt').textContent = S.results.length + ' de ' + list.length + ' procesados';
      if (i < list.length && pause) await sleep(pause);
    }
  } catch(e){ log('Campaña detenida: ' + msgErr(e), 'er'); toast(msgErr(e), true); }
  finally {
    const done = new Set(S.results.map(x => String(x.email).toLowerCase()));
    list.forEach(d => { if (!done.has(String(d[emailKey]).toLowerCase())) S.results.push({email: d[emailKey], estado: 'Pendiente', error: 'No procesado', datos: d}); });
    await cleanup(ids); S.running = false; window.onbeforeunload = null; lockUI(false);
    $('btnPauseRun').style.display = 'none'; $('btnStop').style.display = 'none'; $('btnCsv').style.display = '';
    const cuenta = est => S.results.filter(x => x.estado === est).length;
    const sent = cuenta('Enviado'), pending = cuenta('Pendiente'), uncertain = cuenta('Por verificar'), errors = cuenta('Error');
    $('bar').style.width = (list.length ? (list.length - pending) / list.length * 100 : 0) + '%';
    $('progTxt').textContent = `Terminado · ${sent} enviados · ${errors} errores · ${pending} pendientes · ${uncertain} por verificar`;
    toast('Campaña finalizada. Revisa el resumen y descarga los resultados.', errors + uncertain > 0);
  }
}
$('btnCsv').onclick = () => {
  const q = v => { let t = String(v ?? ''); if (/^[=+@-]/.test(t)) t = "'" + t; return '"' + t.replace(/"/g, '""') + '"'; };
  const headers = ['Correo','Estado','Error', ...(S.resultHeaders || [])];
  const lines = [headers.map(q).join(',')];
  S.results.forEach(r => lines.push([r.email, r.estado, r.error, ...(S.resultKeys || []).map(k => r.datos ? r.datos[k] : '')].map(q).join(',')));
  const url = URL.createObjectURL(new Blob(['\ufeff' + lines.join('\r\n')], {type:'text/csv;charset=utf-8'}));
  const a = document.createElement('a'); a.href = url; a.download = 'resultados_' + (clave(S.resultName || 'envio') || 'envio') + '.csv';
  document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(url), 1000);
};
renderPreview();
</script>
